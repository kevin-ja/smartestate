# Copiar a .env y completar. .env no se versiona.
# Nunca poner aquí variables DATABRICKS_*: pisan la autenticación de Terraform.

# Terraform (infra/) — las lee como TF_VAR_*
TF_VAR_account_id=                 # ID de la cuenta AWS (12 dígitos)
TF_VAR_databricks_account_id=      # UUID de la cuenta Databricks
TF_VAR_daily_user_email=           # usuario diario NO admin de Databricks

# Pipeline de datos
SMARTESTATE_RAW_ROOT=              # s3://smartestate-lake-<aws-account-id>/raw
SMARTESTATE_REF_ROOT=              # s3://smartestate-lake-<aws-account-id>/ref (catálogo INEGI, D9)

# Asset Bundle (scripts/bundle.sh los mapea a DATABRICKS_HOST y BUNDLE_VAR_*)
SMARTESTATE_WORKSPACE_HOST=        # terraform output databricks_workspace_url (cambia en cada recreación)
SMARTESTATE_JOBS_SP_ID=            # terraform output databricks_jobs_sp_application_id (fijo)
